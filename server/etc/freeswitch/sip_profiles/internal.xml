<!--
  CommsChannel internal profile.

  Bound to 127.0.0.1:5065 ONLY. Kamailio is the public edge and has already
  authenticated the caller, so this profile does not re-challenge (auth-calls
  false). That is safe precisely because nothing off-box can reach it — if this
  ever binds a public address, auth-calls MUST become true.

  Calls arrive in context "default", which is the portal's xml_curl dialplan.
-->
<profile name="internal">
  <settings>
    <param name="sip-ip" value="127.0.0.1"/>
    <param name="sip-port" value="5065"/>
    <param name="rtp-ip" value="__PUBLIC_IP__"/>
    <param name="ext-rtp-ip" value="__PUBLIC_IP__"/>
    <param name="ext-sip-ip" value="127.0.0.1"/>
    <param name="context" value="default"/>
    <param name="dialplan" value="XML"/>

    <!-- Kamailio already authenticated; do not challenge the trusted leg -->
    <param name="auth-calls" value="false"/>
    <param name="accept-blind-auth" value="false"/>
    <param name="accept-blind-reg" value="false"/>
    <param name="auth-all-packets" value="false"/>

    <param name="apply-inbound-acl" value="loopback.auto"/>

    <param name="rtp-timer-name" value="soft"/>
    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="disable-transcoding" value="false"/>
    <param name="inbound-codec-negotiation" value="generous"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="manage-presence" value="false"/>
    <param name="aggressive-nat-detection" value="true"/>
    <param name="apply-nat-acl" value="rfc1918"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>
    <param name="enable-timer" value="false"/>
    <param name="minimum-session-expires" value="120"/>
  </settings>
</profile>
