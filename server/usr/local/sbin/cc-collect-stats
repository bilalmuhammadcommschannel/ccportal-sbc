#!/bin/bash
# Collects operational + security stats as ROOT and writes a JSON snapshot the
# portal (www-data) can read. Deliberate design: the web process never gets
# fail2ban / asterisk-CLI privileges — it only reads a file. (Unblock-from-UI
# goes the other way, through the narrowly-scoped setuid helper /usr/local/sbin/cc-fw.)
set -u
OUT=/var/lib/ccportal/stats.json
HIST=/var/lib/ccportal/stats-history.json
CPUPREV=/var/lib/ccportal/.cpustat
TMP=$(mktemp)

json_escape(){ printf '%s' "$1" | tr -d '\000-\037\177' | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# --- fail2ban (per-jail counts + per-IP bans with ban time) ---
jails_json=""
bans_json=""          # flat list across all jails: {ip,jail,since,until}
tot_banned=0; tot_failed=0; cur_banned=0
for j in $(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:\s*//p' | tr ',' ' '); do
  s=$(fail2ban-client status "$j" 2>/dev/null)
  cf=$(printf '%s' "$s" | sed -n 's/.*Currently failed:\s*\([0-9]*\).*/\1/p' | head -1)
  tf=$(printf '%s' "$s" | sed -n 's/.*Total failed:\s*\([0-9]*\).*/\1/p' | head -1)
  cb=$(printf '%s' "$s" | sed -n 's/.*Currently banned:\s*\([0-9]*\).*/\1/p' | head -1)
  tb=$(printf '%s' "$s" | sed -n 's/.*Total banned:\s*\([0-9]*\).*/\1/p' | head -1)
  ips=$(fail2ban-client get "$j" banip 2>/dev/null | tr '\n' ' ' | sed 's/ *$//')
  cf=${cf:-0}; tf=${tf:-0}; cb=${cb:-0}; tb=${tb:-0}
  tot_banned=$((tot_banned+tb)); tot_failed=$((tot_failed+tf)); cur_banned=$((cur_banned+cb))
  [ -n "$jails_json" ] && jails_json="$jails_json,"
  jails_json="$jails_json{\"name\":\"$(json_escape "$j")\",\"currently_failed\":$cf,\"total_failed\":$tf,\"currently_banned\":$cb,\"total_banned\":$tb,\"banned_ips\":\"$(json_escape "$ips")\"}"
  # per-IP with ban time. `banip --with-time` => "IP\tYYYY-MM-DD HH:MM:SS + <bantime> = YYYY-MM-DD HH:MM:SS"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    bip=$(printf '%s' "$line" | awk '{print $1}')
    [ -z "$bip" ] && continue
    since=$(printf '%s' "$line" | sed -n 's/^[^ ]*[[:space:]]*\([0-9-]\{10\} [0-9:]\{8\}\).*/\1/p')
    until=$(printf '%s' "$line" | sed -n 's/.*=[[:space:]]*\([0-9-]\{10\} [0-9:]\{8\}\).*/\1/p')
    [ -n "$bans_json" ] && bans_json="$bans_json,"
    bans_json="$bans_json{\"ip\":\"$(json_escape "$bip")\",\"jail\":\"$(json_escape "$j")\",\"since\":\"$(json_escape "$since")\",\"until\":\"$(json_escape "$until")\"}"
  done < <(fail2ban-client get "$j" banip --with-time 2>/dev/null)
done

# --- asterisk (chan_sip media anchor) live calls ---
# JSON key stays "switch" (media-stack-agnostic) so the portal never cares which
# B2BUA is behind it. Aggregate counts come from `core show channels count`;
# per-channel detail is read from each channel's own variables (CC_DIR / CC_DEST
# / CC_ACCOUNT / CC_CARRIER, set by the AGI in extensions.conf). The raw channel
# name (SIP/kamailio-XXXX) is NEVER exposed to the portal.
sw_up=0; sw_calls=0; sw_channels=0; sw_chan_json="[]"
if systemctl is-active --quiet asterisk; then
  sw_up=1
  cnt=$(asterisk -rx "core show channels count" 2>/dev/null)
  sw_channels=$(printf '%s\n' "$cnt" | awk '/active channels/{print $1; exit}')
  sw_calls=$(printf '%s\n'    "$cnt" | awk '/active calls/{print $1; exit}')
  sw_channels=${sw_channels:-0}; sw_calls=${sw_calls:-0}
  # channel names, one per line (concise output is !-delimited; field 1 = name)
  names=$(asterisk -rx "core show channels concise" 2>/dev/null | awk -F'!' 'NF>1{print $1}')
  chan_json=""; count=0
  while IFS= read -r ch; do
    [ -z "$ch" ] && continue
    count=$((count+1)); [ "$count" -gt 60 ] && break   # bound per-channel calls under load
    info=$(asterisk -rx "core show channel $ch" 2>/dev/null)
    # channel variables print flush-left as NAME=value in the "Variables:" section
    gv(){ printf '%s\n' "$info" | sed -n "s/^[[:space:]]*$1=//p" | head -1 | tr -d '\r'; }
    ccdir=$(gv CC_DIR); cccar=$(gv CC_CARRIER); ccact=$(gv CC_ACCOUNT); dest=$(gv CC_DEST)
    # only the anchor's inbound-from-Kamailio leg carries the CC_ vars; skip the
    # far (carrier/endpoint) leg so each call shows as one row, not two.
    [ -z "$ccdir" ] && continue
    uuid=$(gv CC_CALLKEY)              # billing call id (safe); NOT the channel name
    state=$(printf '%s\n' "$info" | sed -n 's/^[[:space:]]*State:[[:space:]]*//p' | head -1 | tr -d '\r')
    trunk=""; [ "$ccdir" = "inbound" ] && trunk="endpoint"
    [ -n "$chan_json" ] && chan_json="$chan_json,"
    chan_json="$chan_json{\"uuid\":\"$(json_escape "$uuid")\",\"direction\":\"$(json_escape "$ccdir")\",\"account\":\"$(json_escape "$ccact")\",\"carrier_id\":\"$(json_escape "$cccar")\",\"trunk\":\"$(json_escape "$trunk")\",\"cid\":\"\",\"dest\":\"$(json_escape "$dest")\",\"codec\":\"\",\"state\":\"$(json_escape "$state")\"}"
  done <<< "$names"
  [ -n "$chan_json" ] && sw_chan_json="[$chan_json]"
fi

# --- services ---
svc_json=""
for s in nginx php8.3-fpm mariadb fail2ban asterisk kamailio nftables ccportal-scheduler.timer certbot.timer; do
  st=$(systemctl is-active "$s" 2>/dev/null || echo unknown)
  [ -n "$svc_json" ] && svc_json="$svc_json,"
  svc_json="$svc_json{\"name\":\"$(json_escape "$s")\",\"state\":\"$(json_escape "$st")\"}"
done

# --- kamailio registrations (usrloc location table, db_mode write-through) ---
reg_json=""; reg_ips=""
while IFS=$'\t' read -r ruser rcontact rrecv rua rexp; do
  [ -z "$ruser" ] && continue
  # rsrc = the REAL registration source Kamailio recorded (location.received);
  # rip = the client-supplied Contact host (display only — never trusted).
  rsrc=$(printf '%s' "$rrecv" | sed -n 's#.*sip:\([0-9.]*\).*#\1#p')
  rip=$(printf '%s' "$rcontact" | sed -n 's#.*@\([^:;>]*\).*#\1#p')
  [ "$rua" = "NULL" ] && rua=""
  disp="${rsrc:-$rip}"
  # SECURITY: only the REAL source IP is trusted for firewall/ACL — never the
  # client-supplied Contact host (which an authenticated tenant can forge).
  case "$rsrc" in ''|*[!0-9.]*) ;; *) reg_ips="$reg_ips $rsrc";; esac
  [ -n "$reg_json" ] && reg_json="$reg_json,"
  reg_json="$reg_json{\"aor\":\"$(json_escape "$ruser")\",\"ip\":\"$(json_escape "$disp")\",\"ua\":\"$(json_escape "$rua")\",\"expires\":\"$(json_escape "$rexp")\"}"
done < <(mysql kamailio -N -e "SELECT username,contact,COALESCE(received,''),COALESCE(user_agent,''),expires FROM location" 2>/dev/null)

# --- STANDING RULE: every carrier IP + every registered-endpoint IP is auto-trusted ---
# Carriers (carrier_ips, IPv4 IP-auth on an active carrier) and the IPs our
# endpoints are currently registered from are, every cycle:
#   * added to Kamailio's ACL htables — carrieracl (auth-skip for inbound
#     carriers) / regacl (ban + pike exemption for endpoints);
#   * added to the nftables carrier_v4 allow-set (bypasses the SIP rate meters);
#   * added to every fail2ban jail's ignore list, and cleared from any ban.
# So trusted traffic is never rate-limited or blocked. Add a carrier or register
# a phone and it is trusted within one cycle — no manual firewall edits.
if command -v kamcmd >/dev/null 2>&1; then
  carrier_ips=$(mysql switch -N -e "SELECT ci.ipaddress FROM carrier_ips ci JOIN carrier c ON c.carrier_id=ci.carrier_id WHERE ci.auth_type='IP' AND c.carrier_status='1' AND ci.ipaddress REGEXP '^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+\$'" 2>/dev/null)
  for cip in $carrier_ips; do kamcmd htable.sets carrieracl "$cip" 1 >/dev/null 2>&1; done
  for rip in $reg_ips;     do kamcmd htable.sets regacl     "$rip" 1 >/dev/null 2>&1; done
  trusted=$(printf '%s\n' $carrier_ips $reg_ips | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | sort -u)
  for ip in $trusted; do
    command -v nft >/dev/null 2>&1 && nft add element inet filter carrier_v4 "{ $ip }" >/dev/null 2>&1
    # SIP data-plane jails ONLY — never sshd or the portal jails (a SIP source
    # must not gain SSH/portal brute-force immunity).
    for j in ccsip-auth ccsip-scanner; do
      fail2ban-client set "$j" addignoreip "$ip" >/dev/null 2>&1
      fail2ban-client set "$j" unbanip    "$ip" >/dev/null 2>&1
    done
    kamcmd htable.delete ipban     "$ip" >/dev/null 2>&1
    kamcmd htable.delete ipbanperm "$ip" >/dev/null 2>&1
  done
fi

# --- host ---
load=$(cut -d' ' -f1 /proc/loadavg)
memtot=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo)
memav=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo)
disk=$(df -P / | awk 'NR==2{print $5}' | tr -d '%')
up=$(awk '{print int($1)}' /proc/uptime)
mem_pct=0; [ "${memtot:-0}" -gt 0 ] && mem_pct=$(( (memtot-memav)*100/memtot ))

# CPU % since the previous run (delta of /proc/stat), so it reflects the ~20s window.
read -r _ u n sy id io ir sof st _ < /proc/stat
cur_idle=$((id+io)); cur_tot=$((u+n+sy+id+io+ir+sof+st))
cpu_pct=0
if [ -f "$CPUPREV" ]; then
  read -r p_idle p_tot < "$CPUPREV" 2>/dev/null || { p_idle=0; p_tot=0; }
  d_tot=$((cur_tot-p_tot)); d_idle=$((cur_idle-p_idle))
  [ "$d_tot" -gt 0 ] && cpu_pct=$(( (100*(d_tot-d_idle)) / d_tot ))
fi
echo "$cur_idle $cur_tot" > "$CPUPREV"
[ "$cpu_pct" -lt 0 ] && cpu_pct=0; [ "$cpu_pct" -gt 100 ] && cpu_pct=100

cat > "$TMP" <<JSON
{
  "generated_at": "$(date -u '+%Y-%m-%d %H:%M:%S')",
  "fail2ban": { "jails": [$jails_json], "bans": [$bans_json], "currently_banned": $cur_banned, "total_banned": $tot_banned, "total_failed": $tot_failed },
  "switch": { "up": $sw_up, "calls": $sw_calls, "channels": $sw_channels, "channel_list": $sw_chan_json },
  "services": [$svc_json],
  "registrations": [$reg_json],
  "host": { "load": "$load", "cpu_pct": $cpu_pct, "mem_pct": $mem_pct, "mem_total_mb": $memtot, "mem_available_mb": $memav, "disk_used_pct": ${disk:-0}, "uptime_sec": $up }
}
JSON
chmod 644 "$TMP" && mv "$TMP" "$OUT"

# --- rolling history ring buffer for CPU/RAM/live-call sparklines (keep ~2h @ 20s = 360) ---
python3 - "$HIST" "$cpu_pct" "$mem_pct" "$sw_calls" <<'PY' 2>/dev/null || true
import json, sys, os, time
path, cpu, mem, calls = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
hist = []
if os.path.exists(path):
    try: hist = json.load(open(path)).get("samples", [])
    except Exception: hist = []
hist.append({"t": int(time.time()), "cpu": cpu, "mem": mem, "calls": calls})
hist = hist[-360:]
tmp = path + ".tmp"
json.dump({"samples": hist}, open(tmp, "w"))
os.chmod(tmp, 0o644); os.replace(tmp, path)
PY
