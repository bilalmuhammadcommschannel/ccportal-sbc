APP_NAME="CommsChannel SBC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sip.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Portal's own database (Laravel: users, sessions, cache, jobs, audit)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ccportal_app
DB_USERNAME=ccportal
DB_PASSWORD=

# OV500 domain databases (DML only)
SWITCH_DB_HOST=127.0.0.1
SWITCH_DB_PORT=3306
SWITCH_DB_DATABASE=switch
SWITCH_DB_USERNAME=ccportal
SWITCH_DB_PASSWORD=
SWITCHCDR_DB_DATABASE=switchcdr

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Switch integration (FreeSWITCH <-> portal over loopback)
SWITCH_SHARED_SECRET=
SWITCH_SIP_DOMAIN=sip.example.com
SWITCH_SIP_PROXY=127.0.0.1
# High-risk destination prefixes refused before routing (extend to your fraud profile)
# SWITCH_BLOCKED_PREFIXES=870,871,872,873,874,878,881,882,883,8816,8817,979

# First admin (installer sets these; leave blank otherwise)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
